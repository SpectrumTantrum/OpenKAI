find_package(Git QUIET)
set(OPENKAI_SOURCE_DIR "@CMAKE_SOURCE_DIR@")
set(OPENKAI_GIT_REVISION "unknown")
set(OPENKAI_GIT_DIRTY TRUE)
if(Git_FOUND)
  execute_process(
    COMMAND "${GIT_EXECUTABLE}" rev-parse --short=12 HEAD
    WORKING_DIRECTORY "${OPENKAI_SOURCE_DIR}"
    RESULT_VARIABLE OPENKAI_GIT_REVISION_RESULT
    OUTPUT_VARIABLE OPENKAI_GIT_REVISION
    OUTPUT_STRIP_TRAILING_WHITESPACE
  )
  if(NOT OPENKAI_GIT_REVISION_RESULT EQUAL 0)
    set(OPENKAI_GIT_REVISION "unknown")
  endif()
  execute_process(
    COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=normal
    WORKING_DIRECTORY "${OPENKAI_SOURCE_DIR}"
    RESULT_VARIABLE OPENKAI_STATUS_RESULT
    OUTPUT_VARIABLE OPENKAI_STATUS
    OUTPUT_STRIP_TRAILING_WHITESPACE
  )
  if(OPENKAI_STATUS_RESULT EQUAL 0)
    set(OPENKAI_GIT_DIRTY FALSE)
    string(REPLACE "\n" ";" OPENKAI_STATUS_LINES "${OPENKAI_STATUS}")
    foreach(OPENKAI_STATUS_LINE IN LISTS OPENKAI_STATUS_LINES)
      if(OPENKAI_STATUS_LINE AND NOT OPENKAI_STATUS_LINE MATCHES "^\\?\\? build-[^/]*/$")
        set(OPENKAI_GIT_DIRTY TRUE)
      endif()
    endforeach()
  endif()
endif()

set(OPENKAI_BUILD_INFO_DIR "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_LIBDIR@/cmake/OpenKAI")
file(MAKE_DIRECTORY "${OPENKAI_BUILD_INFO_DIR}")
set(OPENKAI_BUILD_INFO_PATH "${OPENKAI_BUILD_INFO_DIR}/OpenKAIBuildInfo.cmake")
file(WRITE "${OPENKAI_BUILD_INFO_PATH}"
  "set(OPENKAI_BUILD_VERSION \"@PROJECT_VERSION@\")\n"
  "set(OPENKAI_BUILD_ABI_VERSION \"0.1\")\n"
  "set(OPENKAI_BUILD_GIT_REVISION \"${OPENKAI_GIT_REVISION}\")\n"
  "set(OPENKAI_BUILD_GIT_DIRTY ${OPENKAI_GIT_DIRTY})\n"
)
message(STATUS "Installed OpenKAI build metadata: version @PROJECT_VERSION@, ABI 0.1, git ${OPENKAI_GIT_REVISION}, dirty ${OPENKAI_GIT_DIRTY}")
