{
	/*global app metadata*/
	"APP": {
		/*class: the class name of the module in C++*/
		"class": "ModuleMgr",
		"appName": "helloOK",
		"bLog": true /*whether to log to log file*/,
		"bStdErr": true /*whether to log to stderr*/
	},
	/*console module*/
	"console": {
		"class": "_Console",
		"bON": false,
		"thread": {
			"name": "thread",
			"class": "_Thread",
			"FPS": 10
		},
		"vBASE": [
			"cam"
		]
	},
	/*view module*/
	"view": {
		"class": "_WindowCV",
		"bON": true,
		"thread": {
			"name": "thread",
			"class": "_Thread",
			"FPS": 30
		},
		"bFullScreen": false,
		"vBASE": [
			"cam"
		]
	},
	/*camera module*/
	"cam": {
		"class": "_Camera",
		"bON": true,
		"thread": {
			"name": "thread",
			"class": "_Thread",
			"FPS": 30
		},
		"deviceID": 0,
		"vSizeRGB": [
			640,
			480
		]
	}
}